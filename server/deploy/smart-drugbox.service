[Unit]
Description=Smart Drugbox FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/smart-drugbox
EnvironmentFile=/opt/smart-drugbox/.env
ExecStart=/opt/smart-drugbox/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8787 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
User=smartdrugbox
Group=smartdrugbox
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/smart-drugbox

[Install]
WantedBy=multi-user.target
